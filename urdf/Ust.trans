<?xml version="1.0" ?>
<robot name="Ust" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="pinky_mcp_joint_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="pinky_mcp_joint">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="pinky_mcp_joint_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

